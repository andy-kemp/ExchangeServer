<Application x:Class="ExchangeCertManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            >
    <Application.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- ================================================================
             Andy Kemp Consulting theme: the copper look used on
             tools/docs/demos.andykemp.com (light theme, Inter)
             ================================================================ -->
        <FontFamily x:Key="AkcFont">pack://application:,,,/Fonts/#Inter</FontFamily>
        <FontFamily x:Key="AkcMono">Cascadia Mono, Consolas</FontFamily>

        <Color x:Key="AkcCopperColor">#8A4E2E</Color>
        <SolidColorBrush x:Key="AkcBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AkcBgSoft" Color="#F7F3EF"/>
        <SolidColorBrush x:Key="AkcPanelRaised" Color="#F4EDE6"/>
        <SolidColorBrush x:Key="AkcText" Color="#302923"/>
        <SolidColorBrush x:Key="AkcHeading" Color="#201A16"/>
        <SolidColorBrush x:Key="AkcMuted" Color="#625850"/>
        <SolidColorBrush x:Key="AkcBorder" Color="#E5D9CE"/>
        <SolidColorBrush x:Key="AkcBorderStrong" Color="#C9A88F"/>
        <SolidColorBrush x:Key="AkcCopper" Color="#8A4E2E"/>
        <SolidColorBrush x:Key="AkcCopperDark" Color="#60351F"/>
        <SolidColorBrush x:Key="AkcOk" Color="#2F6B3A"/>
        <SolidColorBrush x:Key="AkcOkBg" Color="#E7F2E8"/>
        <SolidColorBrush x:Key="AkcWarn" Color="#8A5A00"/>
        <SolidColorBrush x:Key="AkcWarnBg" Color="#FDF3DC"/>
        <SolidColorBrush x:Key="AkcDanger" Color="#A33A2A"/>
        <SolidColorBrush x:Key="AkcDangerDark" Color="#7A2A1D"/>
        <SolidColorBrush x:Key="AkcLogBg" Color="#1F1915"/>
        <SolidColorBrush x:Key="AkcLogText" Color="#EAD9C9"/>

        <!-- Every window: Inter, warm text, white background (applied in App.OnStartup) -->
        <Style x:Key="AkcWindow" TargetType="Window">
            <Setter Property="FontFamily" Value="{StaticResource AkcFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource AkcText}"/>
            <Setter Property="Background" Value="{StaticResource AkcBg}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <!-- Section heading with a numbered copper badge: set Tag to the number -->
        <Style x:Key="AkcSectionHeading" TargetType="ContentControl">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource AkcCopper}" Margin="0,0,8,0">
                                <TextBlock Text="{TemplateBinding Tag}" Foreground="White" FontWeight="Bold" FontSize="11.5"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" TextElement.FontWeight="Bold" TextElement.FontSize="14.5"
                                              TextElement.Foreground="{StaticResource AkcHeading}"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Buttons: secondary by default (white, copper outline) -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource AkcCopperDark}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AkcBorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7" SnapsToDevicePixels="True"/>
                            <!-- Hover/press shade works whatever the button's own background is -->
                            <Border x:Name="Shade" CornerRadius="7" Background="#000000" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                            <Border x:Name="Focus" CornerRadius="8" BorderBrush="{StaticResource AkcCopper}" BorderThickness="2"
                                    Margin="-3" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shade" Property="Opacity" Value="0.07"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shade" Property="Opacity" Value="0.14"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AkcCopper}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AkcCopper}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AkcDanger}"/>
            <Setter Property="Foreground" Value="{StaticResource AkcDanger}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>

        <!-- Small icon-only button (remove, verify) -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource AkcText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AkcBorderStrong}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource AkcText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AkcBorderStrong}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource AkcBorderStrong}"/>
            <Setter Property="Foreground" Value="{StaticResource AkcText}"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource AkcBorderStrong}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource AkcBorderStrong}"/>
            <Setter Property="Foreground" Value="{StaticResource AkcText}"/>
        </Style>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="{StaticResource AkcBgSoft}"/>
            <Setter Property="Foreground" Value="{StaticResource AkcText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AkcBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <!-- GroupBox as a card: small uppercase heading, rounded border -->
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="12,8,12,12"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="BorderBrush" Value="{StaticResource AkcBorder}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="10" SnapsToDevicePixels="True">
                            <DockPanel>
                                <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" Margin="12,10,12,0"
                                                  TextElement.FontWeight="Bold" TextElement.FontSize="11"
                                                  TextElement.Foreground="{StaticResource AkcMuted}"
                                                  RecognizesAccessKey="True">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ProgressBar: copper fill on a warm rounded track; indeterminate shows a moving band -->
        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource AkcCopper}"/>
            <Setter Property="Background" Value="{StaticResource AkcPanelRaised}"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="5" ClipToBounds="True">
                            <Grid ClipToBounds="True">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="5"/>
                                <Border x:Name="Band" Width="90" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"
                                        CornerRadius="5" Visibility="Collapsed">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="BandMove" X="-90"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Band" Property="Visibility" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="BandStory">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="BandMove" Storyboard.TargetProperty="X"
                                                             From="-90" To="600" Duration="0:0:1.6"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="BandStory"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= Exchange Certificate Manager additions ================= -->
        <SolidColorBrush x:Key="AkcInfo" Color="#2D5B8A"/>
        <SolidColorBrush x:Key="AkcInfoBg" Color="#E6EEF7"/>
        <SolidColorBrush x:Key="AkcDangerBg" Color="#F8E5E1"/>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource AkcHeading}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AkcMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AkcHeading}"/>
            <Setter Property="Margin" Value="0,8,0,3"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AkcMuted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style x:Key="MonoTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="{StaticResource AkcMono}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Background" Value="{StaticResource AkcBgSoft}"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>

        <Style x:Key="MultiLineTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="FontFamily" Value="{StaticResource AkcMono}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Left navigation: radio buttons styled as menu items -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource AkcText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Padding="12,9" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Bar" Width="3" CornerRadius="2" Margin="0,0,10,0" Background="Transparent"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AkcPanelRaised}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AkcPanelRaised}"/>
                                <Setter TargetName="Bar" Property="Background" Value="{StaticResource AkcCopper}"/>
                                <Setter Property="Foreground" Value="{StaticResource AkcCopperDark}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded card -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AkcBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Status pill; set Tag to Ok / Warning / Error / Info -->
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource AkcInfoBg}"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource AkcInfo}"/>
            <Setter Property="TextElement.FontWeight" Value="Bold"/>
            <Setter Property="TextElement.FontSize" Value="11"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Ok">
                    <Setter Property="Background" Value="{StaticResource AkcOkBg}"/>
                    <Setter Property="TextElement.Foreground" Value="{StaticResource AkcOk}"/>
                </Trigger>
                <Trigger Property="Tag" Value="Warning">
                    <Setter Property="Background" Value="{StaticResource AkcWarnBg}"/>
                    <Setter Property="TextElement.Foreground" Value="{StaticResource AkcWarn}"/>
                </Trigger>
                <Trigger Property="Tag" Value="Error">
                    <Setter Property="Background" Value="{StaticResource AkcDangerBg}"/>
                    <Setter Property="TextElement.Foreground" Value="{StaticResource AkcDanger}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource AkcBorder}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AkcBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource AkcBgSoft}"/>
            <Setter Property="Foreground" Value="{StaticResource AkcMuted}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="BorderBrush" Value="{StaticResource AkcBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AkcPanelRaised}"/>
                    <Setter Property="Foreground" Value="{StaticResource AkcHeading}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="BorderBrush" Value="{StaticResource AkcBorder}"/>
            <Setter Property="Background" Value="White"/>
        </Style>

    </Application.Resources>
</Application>
