<UserControl x:Class="ExchangeCertManager.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <DockPanel Margin="0,0,0,12" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="{Binding Summary}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource AkcHeading}"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Run checks" Command="{Binding RunCommand}"/>
        </DockPanel>

        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Pill}" Tag="{Binding SeverityText}" VerticalAlignment="Top">
                                <TextBlock Text="{Binding SeverityText}"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{StaticResource AkcHeading}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{StaticResource AkcText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="12,0,0,0" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Area}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AkcCopper}" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Server}" FontSize="11" Foreground="{StaticResource AkcMuted}" HorizontalAlignment="Right" TextWrapping="Wrap" MaxWidth="220"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="{Binding Fix.Label}" Margin="0,8,0,0" Padding="12,5" HorizontalAlignment="Right"
                                        Command="{Binding DataContext.FixCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                        Visibility="{Binding HasFix, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
