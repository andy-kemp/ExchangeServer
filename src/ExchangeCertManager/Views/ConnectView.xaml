<UserControl x:Class="ExchangeCertManager.Views.ConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ExchangeCertManager.Views">
    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <ContentControl Style="{StaticResource AkcSectionHeading}" Tag="1" Content="Exchange server"/>
                <TextBlock Style="{StaticResource Hint}" Text="{Binding LocalServerText}" Margin="0,0,0,6"/>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Server"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Pick a server found in AD, or type any FQDN -->
                    <ComboBox IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Fqdn"
                              ItemsSource="{Binding Discovered}"
                              Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Fqdn}" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="11.5" Opacity="0.75">
                                        <Run Text="{Binding Version, Mode=OneWay}"/><Run Text="   ·   "/><Run Text="{Binding Site, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="1" Content="Find again" Command="{Binding DiscoverCommand}" Margin="8,0,0,0"
                            ToolTip="Look the Exchange servers up in Active Directory again"/>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Text="{Binding DiscoveryText}"/>
                <TextBlock Style="{StaticResource Hint}" Text="Any Mailbox server in the organisation will do: the app finds the rest."/>

                <ContentControl Style="{StaticResource AkcSectionHeading}" Tag="2" Content="Sign in" Margin="0,18,0,8"/>
                <CheckBox Content="Use my current Windows sign-in (Kerberos)" IsChecked="{Binding UseCurrentUser}"/>
                <StackPanel Visibility="{Binding UseCurrentUser, Converter={x:Static v:VisibleWhen.Not}}" Margin="0,6,0,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="User name"/>
                    <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Password"/>
                    <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="The account needs Organization Management, or a role group with the Exchange Server Certificates role."/>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Content="Connect" Command="{Binding ConnectCommand}" Margin="0,0,8,0" IsDefault="True"/>
                    <Button Content="Disconnect" Command="{Binding DisconnectCommand}"
                            Visibility="{Binding State.IsConnected, Converter={x:Static v:VisibleWhen.Instance}}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Background="{StaticResource AkcBgSoft}">
            <StackPanel>
                <TextBlock Text="If it won't connect" FontWeight="Bold" Foreground="{StaticResource AkcHeading}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0">
                    Use the server's FQDN, not an IP address or load-balanced name (Kerberos needs the real host).
                    Check http://server/PowerShell isn't blocked by a firewall, and that the PowerShell virtual directory still allows Kerberos.
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
