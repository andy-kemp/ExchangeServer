<UserControl x:Class="ExchangeCertManager.Views.UrlsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ExchangeCertManager.Views">
    <StackPanel>
        <!-- Current URLs -->
        <DockPanel Margin="0,0,0,8" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="Current URLs" FontWeight="Bold" FontSize="14.5" Foreground="{StaticResource AkcHeading}" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" Margin="0"/>
        </DockPanel>
        <DataGrid ItemsSource="{Binding Entries}" MaxHeight="300">
            <DataGrid.Columns>
                <DataGridTextColumn Header="SERVER" Binding="{Binding Server}" Width="90"/>
                <DataGridTextColumn Header="SERVICE" Binding="{Binding Label}" Width="230"/>
                <DataGridTextColumn Header="INTERNAL" Binding="{Binding InternalText}" Width="*"/>
                <DataGridTextColumn Header="EXTERNAL" Binding="{Binding ExternalText}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,14"
                   Text="The PowerShell virtual directory isn't listed or changed: this app connects through it."/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Namespace -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <ContentControl Style="{StaticResource AkcSectionHeading}" Tag="1" Content="Namespace"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Internal hostname"/>
                    <TextBox Text="{Binding InternalHost, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Content="External is the same (split DNS, recommended)" IsChecked="{Binding SameAsInternal}" Margin="0,8,0,0"/>
                    <StackPanel Visibility="{Binding SameAsInternal, Converter={x:Static v:VisibleWhen.Not}}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="External hostname"/>
                        <TextBox Text="{Binding ExternalHost, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Autodiscover hostname"/>
                    <TextBox Text="{Binding AutodiscoverHost, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Used for the internal Autodiscover SCP. External Autodiscover comes from public DNS, not a URL on Exchange."/>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Set" Margin="0,12,0,3"/>
                    <WrapPanel>
                        <CheckBox Content="Internal URLs" IsChecked="{Binding SetInternal}" Margin="0,0,16,0"/>
                        <CheckBox Content="External URLs" IsChecked="{Binding SetExternal}"/>
                    </WrapPanel>
                    <CheckBox IsChecked="{Binding EcpExternalBlank}" Margin="0,8,0,0">
                        <TextBlock Text="Leave the ECP external URL blank (no admin center from the internet)" TextWrapping="Wrap"/>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Scope -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <ContentControl Style="{StaticResource AkcSectionHeading}" Tag="2" Content="Where"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Servers" Margin="0,0,0,3"/>
                    <ItemsControl ItemsSource="{Binding Servers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,2"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Services"/>
                    <ItemsControl ItemsSource="{Binding Kinds}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,2,16,2"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource PrimaryButton}" Content="Preview changes" Command="{Binding PreviewCommand}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Preview -->
        <Border Style="{StaticResource Card}" Visibility="{Binding HasPreview, Converter={x:Static v:VisibleWhen.Instance}}">
            <StackPanel>
                <ContentControl Style="{StaticResource AkcSectionHeading}" Tag="3" Content="Preview"/>
                <TextBlock Text="{Binding PreviewSummary}" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <Border Style="{StaticResource Pill}" Tag="{Binding CoverageState}" HorizontalAlignment="Stretch" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                    <TextBlock Text="{Binding Coverage}" TextWrapping="Wrap" FontWeight="Normal" FontSize="12"/>
                </Border>
                <DataGrid ItemsSource="{Binding Changes}" MaxHeight="260">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SERVER" Binding="{Binding Entry.Server}" Width="90"/>
                        <DataGridTextColumn Header="SERVICE" Binding="{Binding Entry.Label}" Width="230"/>
                        <DataGridTextColumn Header="NOW" Binding="{Binding Before}" Width="*"/>
                        <DataGridTextColumn Header="BECOMES" Binding="{Binding After}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Exchange commands"/>
                <ItemsControl ItemsSource="{Binding Changes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding CommandText, Mode=OneWay}" BorderThickness="0" Padding="6,2" FontSize="11.5"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource PrimaryButton}" Content="Apply…" Command="{Binding ApplyCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
