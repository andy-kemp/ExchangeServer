<UserControl x:Class="ExchangeCertManager.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:ExchangeCertManager.Views">
    <StackPanel>
        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource AkcMuted}" Margin="0,0,0,8"/>
        <DockPanel Margin="0,0,0,10" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" Margin="8,0,0,0"/>
            <CheckBox DockPanel.Dock="Right" Content="Show self-signed" IsChecked="{Binding ShowSelfSigned}" Margin="12,0"/>
            <TextBlock DockPanel.Dock="Left" Text="Search" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource AkcMuted}"/>
            <TextBox DockPanel.Dock="Left" Width="260" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search name, SAN or thumbprint"/>
        </DockPanel>

        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" MinHeight="180" MaxHeight="360">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="CERTIFICATE" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding CommonName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Badges}" FontSize="11" Foreground="{StaticResource AkcCopper}"
                                           Visibility="{Binding Badges, Converter={x:Static v:VisibleWhen.Instance}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="EXPIRES" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Pill}" Tag="{Binding ExpiryState}">
                                <TextBlock Text="{Binding ExpiryText}"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="ISSUER" Binding="{Binding IssuerShort}" Width="1.3*"/>
                <DataGridTextColumn Header="SERVERS" Binding="{Binding ServersText}" Width="1.2*"/>
                <DataGridTextColumn Header="SERVICES" Binding="{Binding ServicesText}" Width="1.6*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="Select a certificate to work with it."
                   Visibility="{Binding HasSelection, Converter={x:Static v:VisibleWhen.Not}}"/>

        <Grid Margin="0,14,0,0" Visibility="{Binding HasSelection, Converter={x:Static v:VisibleWhen.Instance}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Details -->
            <Border Grid.Column="0" Style="{StaticResource Card}" DataContext="{Binding Selected}">
                <StackPanel>
                    <ContentControl Style="{StaticResource AkcSectionHeading}" Tag="i" Content="Details"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Subject"/>
                    <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding Subject, Mode=OneWay}" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Names (SANs)"/>
                    <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding DomainsText, Mode=OneWay}" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Issuer"/>
                    <TextBlock Text="{Binding Issuer}" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Thumbprint"/>
                    <TextBox Style="{StaticResource MonoTextBox}" Text="{Binding Thumbprint, Mode=OneWay}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Friendly name"/>
                    <TextBlock Text="{Binding FriendlyName}" TextWrapping="Wrap"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Valid until"/>
                    <TextBlock Text="{Binding NotAfter, Converter={x:Static v:DateText.Instance}}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Installed on"/>
                    <ItemsControl ItemsSource="{Binding Installs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,1">
                                    <Run Text="{Binding Server, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text=" · " Foreground="{StaticResource AkcMuted}"/>
                                    <Run Text="{Binding Services, Mode=OneWay}"/>
                                    <Run Text=" · " Foreground="{StaticResource AkcMuted}"/>
                                    <Run Text="{Binding Status, Mode=OneWay}" Foreground="{StaticResource AkcMuted}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Actions -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <ContentControl Style="{StaticResource AkcSectionHeading}" Tag="1" Content="Assign services"/>
                        <WrapPanel>
                            <CheckBox Content="IIS" IsChecked="{Binding Services.Iis}" Margin="0,0,16,0"/>
                            <CheckBox Content="SMTP" IsChecked="{Binding Services.Smtp}" Margin="0,0,16,0"/>
                            <CheckBox Content="IMAP" IsChecked="{Binding Services.Imap}" Margin="0,0,16,0"/>
                            <CheckBox Content="POP" IsChecked="{Binding Services.Pop}"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="On these servers"/>
                        <ItemsControl ItemsSource="{Binding AssignServers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,2"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Hint}" Text="Only servers that hold this certificate are listed. Use Deploy to add it to others."/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Assign" Command="{Binding AssignCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <ContentControl Style="{StaticResource AkcSectionHeading}" Tag="2" Content="More actions"/>
                        <WrapPanel>
                            <Button Content="Renew…" Command="{Binding RenewCommand}" Margin="0,0,8,8" ToolTip="New request with the same names"/>
                            <Button Content="Deploy to servers…" Command="{Binding DeployCommand}" Margin="0,0,8,8"/>
                            <Button Content="Export PFX…" Command="{Binding ExportCommand}" Margin="0,0,8,8"/>
                            <Button Content="Copy thumbprint" Command="{Binding CopyThumbprintCommand}" Margin="0,0,8,8"/>
                            <Button Style="{StaticResource DangerButton}" Content="Remove from ticked servers" Command="{Binding RemoveCommand}" Margin="0,0,8,8" Padding="12,6"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
