<Window x:Class="ExchangeCertManager.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exchange Certificate Manager" Width="720" Height="450"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True" Topmost="True"
        Icon="pack://application:,,,/app.ico">
    <!-- The AKC splash: original Andy Kemp black and copper (its own colours, not the theme), with Atlas standing
         on the right and his head rising above the card. Version in AKC green (#7FBF63, andykemp.com's dark-theme green). -->
    <Grid>
        <!-- The card, starting lower than the window so Atlas can rise above it -->
        <Border Background="#090909" CornerRadius="14" Margin="16,76,16,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.45" />
            </Border.Effect>
            <Grid>
                <!-- Soft copper glow behind Atlas -->
                <Ellipse Width="320" Height="270" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-24,-10" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#55BD7448" Offset="0" />
                            <GradientStop Color="#00BD7448" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Grid Margin="36,30,36,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="230" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Image Source="pack://application:,,,/Assets/akc-logo-header.png" Height="48" HorizontalAlignment="Left"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,8,8,8">
                        <TextBlock x:Name="UpdatingLabel" Text="Updating" Foreground="#B9AFA6" FontSize="16" FontWeight="SemiBold" Visibility="Collapsed" />
                        <TextBlock Text="Exchange Certificate Manager" Foreground="White" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock x:Name="VersionText" Text="Version" Foreground="#7FBF63" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock x:Name="Tagline" Text="Request, renew, deploy and health-check Exchange certificates and URLs. Runs as you."
                                   Foreground="#B9AFA6" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <ProgressBar x:Name="Progress" Grid.Row="2" IsIndeterminate="True" Maximum="100" Height="4" Foreground="#BD7448" Background="#2A2420" BorderThickness="0" Margin="0,0,16,10" />

                    <TextBlock x:Name="StatusText" Grid.Row="3" Text="Starting…" Foreground="#B9AFA6" FontSize="12" VerticalAlignment="Bottom" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="www.andykemp.com" Foreground="#D59A72" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                </Grid>
            </Grid>
        </Border>

        <!-- Atlas, over the card: feet just above the footer line, antenna and the top of his head rising about 20px
             above the card's top edge -->
        <Image Source="pack://application:,,,/Assets/atlas.png" Height="320" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Margin="0,0,60,74" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False">
            <Image.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.5" />
            </Image.Effect>
        </Image>
    </Grid>
</Window>
