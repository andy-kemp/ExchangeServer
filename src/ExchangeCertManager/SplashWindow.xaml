<Window x:Class="ExchangeCertManager.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exchange Certificate Manager" Width="620" Height="360"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True" Topmost="True"
        Icon="pack://application:,,,/app.ico">
    <!-- Same as the AKC Audit Collector splash: original Andy Kemp black and copper, its own colours (not the theme). -->
    <Border Background="#090909" CornerRadius="14" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.45" />
        </Border.Effect>
        <Grid Margin="36,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image Source="pack://application:,,,/Assets/akc-logo-header.png" Height="52" HorizontalAlignment="Left"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="Exchange Certificate Manager" Foreground="White" FontSize="30" FontWeight="Bold" />
                <TextBlock x:Name="VersionText" Text="Version" Foreground="#D59A72" FontSize="14" Margin="0,4,0,0" />
                <TextBlock Text="Request, renew, deploy and health-check Exchange certificates. Runs as you." Foreground="#B9AFA6" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="4" Foreground="#BD7448" Background="#2A2420" BorderThickness="0" Margin="0,0,0,10" />
            <TextBlock x:Name="StatusText" Grid.Row="3" Text="Starting…" Foreground="#B9AFA6" FontSize="12" />
        </Grid>
    </Border>
</Window>
